{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "love-sync",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_TURNSTILE_SITEKEY": "3x00000000000000000000FF", // Mock testing sitekey
    "NEXT_PUBLIC_ACTIVE_PAYMENT_PROVIDER": "paddle",
    "NEXT_PUBLIC_PADDLE_ENVIRONMENT": "production",
    "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN": "live_a0cf0be4069f975bf53bdb7c002",
    "PADDLE_MONTHLY_PRICE_ID": "pri_01kz3ez63mzsfc416dyhx8exas",
    "PADDLE_YEARLY_PRICE_ID": "pri_01kz3f9jx3x3yqzbxz9mgdf8yd",
    "PADDLE_PRODUCT_ID": "pro_01kz3ejh5rzvt9hf0cy064kjyq",
    
    // Feature Flags default values
    "NEXT_PUBLIC_FEAT_AI_FEATURES": "false",
    "NEXT_PUBLIC_FEAT_VIDEO_PROFILES": "false",
    "NEXT_PUBLIC_FEAT_VOICE_MESSAGES": "false",
    "NEXT_PUBLIC_FEAT_ID_VERIFICATION": "true",
    "NEXT_PUBLIC_FEAT_REFERRAL_PROGRAM": "false",
    "NEXT_PUBLIC_FEAT_GIFT_SUBSCRIPTIONS": "false",
    "NEXT_PUBLIC_FEAT_ADVANCED_MATCHING": "true",
    "NEXT_PUBLIC_FEAT_PAYMENT_STRIPE": "false",
    "NEXT_PUBLIC_FEAT_PAYMENT_PAYPAL": "false",
    "NEXT_PUBLIC_FEAT_PAYMENT_MOLLIE": "false",
    "NEXT_PUBLIC_FEAT_PAYMENT_ADYEN": "false",
    "NEXT_PUBLIC_FEAT_PAYMENT_CHECKOUT": "false"
  }
}
